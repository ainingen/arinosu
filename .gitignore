# ---- Unity が生成するフォルダ（コミット不要）----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Addressables / Asset Store が生成するもの
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ビルドのたびに Performance Testing パッケージ（URP・2D Animation の依存）が
# 書き出す一時ファイル。正常にビルドが終われば自動で消えるが、
# 中断されたときに残るので除外しておく。
# Assets/Resources.meta は除外しない（自前の Resources を作ったときに見落とすため）
/[Aa]ssets/Resources/PerformanceTestRun*.json*

# ---- エディタ / IDE ----
.vs/
.vscode/
.idea/
.consulo/
.vsconfig
*.userprefs
*.pidb
*.booproj
*.svd
*.suo
*.user
*.userosscache
*.sln.docstates

# ---- 自動生成されるソリューション / プロジェクトファイル ----
*.csproj
*.unityproj
*.sln
*.slnx
*.tmp
*.pdb.meta
*.mdb
*.mdb.meta
*.opendb
*.VC.db

# ---- ビルド成果物 ----
ExportedObj/
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---- OS が作るファイル ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Unity のクラッシュレポート ----
sysinfo.txt
